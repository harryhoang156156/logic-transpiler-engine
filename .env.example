# LLM Provider Configuration (NVIDIA NIM OpenAI-Compatible Endpoint)
NVIDIA_API_KEY=nvapi-your_nvidia_nim_key_here
NVIDIA_BASE_URL=https://nvidia.com
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Target Bot Runtime Variables (Only needed when running generated bot scripts)
RPC_URL=https://helius-rpc.com
PRIVATE_KEY=your_base58_burner_wallet_private_key
REDIS_URL=redis://127.0.0.1:6379
